generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── CRM: лиды с квиза 10K Traffic ───────────────────────────────────
// Статусы воронки (строка, не enum — чтобы менять без миграций):
// NEW (Лид) → CALL1 (Первый звонок) → OFFER (Звонок-КП) → DECISION (Решение)
// → INVOICE (Счёт) → BOOKED (Бронь) → CLIENT (Клиент, авто-создаёт Client) → BASE (База)

model Lead {
  id        String     @id @default(cuid())

  name      String
  phone     String?
  telegram  String?
  lang      String     @default("en")

  // Ниша/кампания: берётся из utm_campaign, можно править руками
  niche     String     @default("no-campaign")
  source    String?    // pathname лендинга: / | /r | /r/s
  utm       Json?      // все utm-метки + fbclid как пришли
  answers   Json?      // ответы квиза [{question, answer}]

  status    String     @default("NEW")
  note      String?    @db.Text

  // Экономика: SOLD-лид = клиент, платит weeklyFee в неделю
  weeklyFee Int        @default(150)
  soldAt    DateTime?  // когда купил
  churnedAt DateTime?  // когда отвалился (null = платит до сих пор)

  payments  Payment[]
  client    Client?

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([niche, createdAt(sort: Desc)])
}

// Карточка клиента (проект) — создаётся автоматически при переводе лида в CLIENT.
// Сумма факт и дата последней оплаты считаются из Payment лида, руками не вводятся.
model Client {
  id         String    @id @default(cuid())
  leadId     String    @unique
  lead       Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  project    String              // название проекта
  teamlead   String?             // тимлид
  targetolog String?             // таргетолог — кто ведёт проект
  planAmount Float?              // сумма план, $
  service    String?             // услуга, на какую закрыли
  launchAt   DateTime?           // дата запуска
  nextPayAt  DateTime?           // дата следующей оплаты (для напоминалок)
  payFormat  String?             // формат оплаты: 50/50, фулл, 150$/нед...
  payMethod  String?             // способ оплаты, удобный клиенту
  status     String    @default("запуск") // статус проекта: запуск / активен / пауза / закрыт

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status, nextPayAt])
}

// Фактический платёж клиента (SOLD-лида): сумма, куда платил, скрин подтверждения
model Payment {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  amount     Float
  method     String?  // куда платил: zelle / карта / кэш / крипта ...
  screenshot String?  @db.Text // data-url base64 скрина подтверждения
  paidAt     DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([leadId, paidAt(sort: Desc)])
}

// Расход на рекламу: одна цифра на нишу в неделю, вводится руками
model AdSpend {
  id        String   @id @default(cuid())
  niche     String
  weekStart DateTime // понедельник недели (UTC, 00:00)
  amount    Float    @default(0)

  @@unique([niche, weekStart])
}
